BRIDGE2_CONTRACT_ADDRESS=0x2df1c51e09aecf9cacb7bc98cb1742757f163df7
BRIDGE_SCAN_START_BLOCK=495895095
BRIDGE_SCAN_CHUNK_SIZE=2000
BRIDGE_SCAN_MAX_CHUNKS_PER_RUN=200
BRIDGE_SCAN_RETRY_ATTEMPTS=3
BRIDGE_SCAN_RETRY_BASE_DELAY_MS=500

# Leaderboard seed
LEADERBOARD_URL=https://stats-data.hyperliquid.xyz/Mainnet/leaderboard

# Position polling
