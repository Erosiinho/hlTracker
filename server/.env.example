POSITION_POLL_CONCURRENCY=5
POSITION_POLL_DELAY_MS=200
POSITION_POLL_BATCH_SIZE=500

# Trade-feed address discovery (long-running listener, not a cron job)
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
TRADES_LISTENER_FLUSH_INTERVAL_MS=10000
